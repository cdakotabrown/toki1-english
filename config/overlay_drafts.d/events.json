  "EXEDIR/DATE2.EXN:0x82fc": "Go Easy... (vocal)",
  "EXEDIR/DATE2.EXN:0x8310": "Sissy Boys... (vocal)",
  "EXEDIR/DATE2.EXN:0x9614": "Go Easy on Love",
  "EXEDIR/DATE2.EXN:0x9629": "Tokimeki",
  "EXEDIR/DATE2.EXN:0x963e": "Our Time",
  "EXEDIR/DATE2.EXN:0x9653": "Song of the Sissy Boys",
  "TARA_OBJ/KARAKASI.BIN:0x0": "In sunbeams",
  "TARA_OBJ/KARAKASI.BIN:0x10": "through the leaves",
  "TARA_OBJ/KARAKASI.BIN:0x848": "our",
  "TARA_OBJ/KARAKASI.BIN:0x850": "time",
  "TARA_OBJ/KARAKASI.BIN:0x1c": "drifts gently by",
  "TARA_OBJ/KARAKASI.BIN:0x2c": "That smile I",
  "TARA_OBJ/KARAKASI.BIN:0x3c": "dreamed of so long",
  "TARA_OBJ/KARAKASI.BIN:0x48": "now right beside it",
  "TARA_OBJ/KARAKASI.BIN:0x54": "here I am",
  "TARA_OBJ/KARAKASI.BIN:0x60": "In my heart",
  "TARA_OBJ/KARAKASI.BIN:0x6c": "a flutter",
  "TARA_OBJ/KARAKASI.BIN:0x78": "this love spilling over",
  "TARA_OBJ/KARAKASI.BIN:0x88": "I want to feel",
  "TARA_OBJ/KARAKASI.BIN:0x98": "forever",
  "TARA_OBJ/KARAKASI.BIN:0xa8": "just you and me",
  "TARA_OBJ/KARAKASI.BIN:0xbc": "our shining time",
  "TARA_OBJ/KARAKASI.BIN:0x148": "I gave up...",
  "TARA_OBJ/KARAKASI.BIN:0x158": "You've got",
  "TARA_OBJ/KARAKASI.BIN:0x164": "a perfect match,",
  "TARA_OBJ/KARAKASI.BIN:0x170": "a girl you're",
  "TARA_OBJ/KARAKASI.BIN:0x180": "going out with,",
  "TARA_OBJ/KARAKASI.BIN:0x190": "I know",
  "TARA_OBJ/KARAKASI.BIN:0x898": "Cuter",
  "TARA_OBJ/KARAKASI.BIN:0x19c": "than me?",
  "TARA_OBJ/KARAKASI.BIN:0x1a8": "I don't think so",
  "TARA_OBJ/KARAKASI.BIN:0x1b4": "Picking a girl like that",
  "TARA_OBJ/KARAKASI.BIN:0x1c4": "shows your taste,",
  "TARA_OBJ/KARAKASI.BIN:0x1d4": "we'd never match",
  "TARA_OBJ/KARAKASI.BIN:0x1e8": "When I was",
  "TARA_OBJ/KARAKASI.BIN:0x1f4": "feeling low",
  "TARA_OBJ/KARAKASI.BIN:0x8ac": "out of the blue",
  "TARA_OBJ/KARAKASI.BIN:0x200": "you said something kind",
  "TARA_OBJ/KARAKASI.BIN:0x214": "So theatrical,",
  "TARA_OBJ/KARAKASI.BIN:0x8bc": "so put",
  "TARA_OBJ/KARAKASI.BIN:0x224": "on, but still",
  "TARA_OBJ/KARAKASI.BIN:0x230": "I fell for it",
  "TARA_OBJ/KARAKASI.BIN:0x23c": "When I happened to be near you,",
  "TARA_OBJ/KARAKASI.BIN:0x254": "I got used to you",
  "TARA_OBJ/KARAKASI.BIN:0x268": "and slowly fell for you",
  "TARA_OBJ/KARAKASI.BIN:0x27c": "You were never my type",
  "TARA_OBJ/KARAKASI.BIN:0x294": "not my ideal at all",
  "TARA_OBJ/KARAKASI.BIN:0x2ac": "I know it all too well",
  "TARA_OBJ/KARAKASI.BIN:0x908": "In the",
  "TARA_OBJ/KARAKASI.BIN:0x910": "window",
  "TARA_OBJ/KARAKASI.BIN:0x918": "the view",
  "TARA_OBJ/KARAKASI.BIN:0x920": "is full",
  "TARA_OBJ/KARAKASI.BIN:0x928": "of lies",
  "TARA_OBJ/KARAKASI.BIN:0x930": "and over",
  "TARA_OBJ/KARAKASI.BIN:0x938": "my",
  "TARA_OBJ/KARAKASI.BIN:0x940": "heart",
  "TARA_OBJ/KARAKASI.BIN:0x948": "the cold",
  "TARA_OBJ/KARAKASI.BIN:0x38c": "closes in",
  "TARA_OBJ/KARAKASI.BIN:0x3a4": "if you were here",
  "TARA_OBJ/KARAKASI.BIN:0x960": "I'd",
  "TARA_OBJ/KARAKASI.BIN:0x3b0": "hold you",
  "TARA_OBJ/KARAKASI.BIN:0x968": "tight",
  "TARA_OBJ/KARAKASI.BIN:0x3c8": "if I could turn back time",
  "TARA_OBJ/KARAKASI.BIN:0x3d8": "I'd go back",
  "TARA_OBJ/KARAKASI.BIN:0x974": "right now",
  "TARA_OBJ/KARAKASI.BIN:0x3f0": "if we met in dreams",
  "TARA_OBJ/KARAKASI.BIN:0x41c": "I'd watch you always",
  "TARA_OBJ/KARAKASI.BIN:0x42c": "though I know",
  "TARA_OBJ/KARAKASI.BIN:0x438": "it's weak",
  "TARA_OBJ/KARAKASI.BIN:0x4e0": "\"I like you,\"",
  "TARA_OBJ/KARAKASI.BIN:0x4ec": "\"I don't\" --",
  "TARA_OBJ/KARAKASI.BIN:0x9a4": "who was",
  "TARA_OBJ/KARAKASI.BIN:0x4f8": "the first to say",
  "TARA_OBJ/KARAKASI.BIN:0x508": "such things?",
  "TARA_OBJ/KARAKASI.BIN:0x518": "Racing on by,",
  "TARA_OBJ/KARAKASI.BIN:0x9c0": "my",
  "TARA_OBJ/KARAKASI.BIN:0x528": "memorial",
  "TARA_OBJ/KARAKASI.BIN:0x534": "Again today",
  "TARA_OBJ/KARAKASI.BIN:0x9f0": "at the mirror",
  "TARA_OBJ/KARAKASI.BIN:0x540": "I brush my hair",
  "TARA_OBJ/KARAKASI.BIN:0x550": "My pink lip gloss,",
  "TARA_OBJ/KARAKASI.BIN:0x564": "Sweet",
  "TARA_OBJ/KARAKASI.BIN:0x580": "my special",
  "TARA_OBJ/KARAKASI.BIN:0xa04": "cologne",
  "TARA_OBJ/KARAKASI.BIN:0x5c4": "I love you",
  "TARA_OBJ/KARAKASI.BIN:0x5d0": "I want only you",
  "TARA_OBJ/KARAKASI.BIN:0x5e0": "to look at me",
  "TARA_OBJ/KARAKASI.BIN:0x610": "Looking perfect",
  "TARA_OBJ/KARAKASI.BIN:0x640": "All set, OK",
  "TARA_OBJ/KARAKASI.BIN:0x64c": "A sweet hunch",
  "TARA_OBJ/KARAKASI.BIN:0x65c": "on the breeze",
  "TARA_OBJ/KARAKASI.BIN:0x688": "My uniform ribbon",
  "TARA_OBJ/KARAKASI.BIN:0x6b8": "once I retie it",
  "TARA_OBJ/KARAKASI.BIN:0x6c8": "today I can say it",
  "EXEDIR/BUNKA_SD.EXN:0x7881": "Three years ago we",
  "EXEDIR/BUNKA_SD.EXN:0x7891": "enrolled, and already those",
  "EXEDIR/BUNKA_SD.EXN:0x78a9": "years are nearly over.",
  "EXEDIR/BUNKA_SD.EXN:0x78c9": "Studies, sports,",
  "EXEDIR/BUNKA_SD.EXN:0x78e1": "club activities...",
  "EXEDIR/BUNKA_SD.EXN:0x78f9": "I have spent truly",
  "EXEDIR/BUNKA_SD.EXN:0x7909": "full, happy days.",
  "EXEDIR/BUNKA_SD.EXN:0x7925": "And yet there is",
  "EXEDIR/BUNKA_SD.EXN:0x7939": "one thing I regret.",
  "EXEDIR/BUNKA_SD.EXN:0x7959": "It is that I never met",
  "EXEDIR/BUNKA_SD.EXN:0x7971": "a truly wonderful man.",
  "EXEDIR/BUNKA_SD.EXN:0x7991": "Graduation is near,",
  "EXEDIR/BUNKA_SD.EXN:0x79b1": "but I believe someone",
  "EXEDIR/BUNKA_SD.EXN:0x79c5": "wonderful will appear.",
  "EXEDIR/BUNKA_SD.EXN:0x79e5": "And then",
  "EXEDIR/BUNKA_SD.EXN:0x79f1": "I mean to fulfill",
  "EXEDIR/BUNKA_SD.EXN:0x7a0d": "this school's legend.",
  "EXEDIR/BUNKA_SD.EXN:0x7a2d": "Ever since I was little,",
  "EXEDIR/BUNKA_SD.EXN:0x7a41": "I have been frail.",
  "EXEDIR/BUNKA_SD.EXN:0x7a55": "If I exercise too hard,",
  "EXEDIR/BUNKA_SD.EXN:0x7a71": "I quickly",
  "EXEDIR/BUNKA_SD.EXN:0x7a7d": "faint from anemia.",
  "EXEDIR/BUNKA_SD.EXN:0x7aa1": "Because of that,",
  "EXEDIR/BUNKA_SD.EXN:0x7ab5": "I have few friends.",
  "EXEDIR/BUNKA_SD.EXN:0x7ad5": "Reading books",
  "EXEDIR/BUNKA_SD.EXN:0x7ae9": "has been, for me,",
  "EXEDIR/BUNKA_SD.EXN:0x7af9": "my only pastime.",
  "EXEDIR/BUNKA_SD.EXN:0x7b15": "But from now on,",
  "EXEDIR/BUNKA_SD.EXN:0x7b2d": "without giving in,",
  "EXEDIR/BUNKA_SD.EXN:0x7b4d": "I mean to walk on",
  "EXEDIR/BUNKA_SD.EXN:0x7b69": "with my anemia.",
  "EXEDIR/BUNKA_SD.EXN:0x7b81": "Since I started here,",
  "EXEDIR/BUNKA_SD.EXN:0x7b95": "in the blink of an eye,",
  "EXEDIR/BUNKA_SD.EXN:0x7ba9": "three whole years",
  "EXEDIR/BUNKA_SD.EXN:0x7bbd": "have nearly gone by.",
  "EXEDIR/BUNKA_SD.EXN:0x7be5": "To get the girls",
  "EXEDIR/BUNKA_SD.EXN:0x7bfd": "to notice me,",
  "EXEDIR/BUNKA_SD.EXN:0x7c15": "studies, sports,",
  "EXEDIR/BUNKA_SD.EXN:0x7c2d": "fashion, checking magazines,",
  "EXEDIR/BUNKA_SD.EXN:0x7c49": "sparing no effort,",
  "EXEDIR/BUNKA_SD.EXN:0x7c61": "I tried everything.",
  "EXEDIR/BUNKA_SD.EXN:0x7c89": "But until I reach",
  "EXEDIR/BUNKA_SD.EXN:0x7ca1": "my final goal,",
  "EXEDIR/BUNKA_SD.EXN:0x7cb9": "I will never give up.",
  "EXEDIR/BUNKA_SD.EXN:0x7ce5": "Again and again,",
  "EXEDIR/BUNKA_SD.EXN:0x7cfd": "I will keep trying.",
  "EXEDIR/BUNKA_SD.EXN:0x7d19": "And I am sure to see",
  "EXEDIR/BUNKA_SD.EXN:0x7d31": "every last",
  "EXEDIR/BUNKA_SD.EXN:0x7d41": "ending there is.",
  "EXEDIR/BUNKA_SD.EXN:0x7d65": "I am a sad guy who",
  "EXEDIR/BUNKA_SD.EXN:0x7d7d": "doesn't even get a name.",
  "EXEDIR/BUNKA_SD.EXN:0x7d95": "This is the only place",
  "EXEDIR/BUNKA_SD.EXN:0x7da5": "I ever get to appear.",
  "EXEDIR/BUNKA_SD.EXN:0x7dbd": "But I still mean to",
  "EXEDIR/BUNKA_SD.EXN:0x7dd9": "keep on living",
  "EXEDIR/BUNKA_SD.EXN:0x7df1": "with a smile.",
  "EXEDIR/BUNKA_SD.EXN:0x7e05": "I am always hiding,",
  "EXEDIR/BUNKA_SD.EXN:0x7e19": "watching a boy.",
  "EXEDIR/BUNKA_SD.EXN:0x7e35": "I believe that someday",
  "EXEDIR/BUNKA_SD.EXN:0x7e4d": "he will turn and see me.",
  "EXEDIR/BUNKA_SD.EXN:0x7e65": "Find me. I'm out there.",
  "EXEDIR/BUNKA_SD.EXN:0x8001": "For your kind assistance",
  "EXEDIR/BUNKA_SD.EXN:0x801d": "in this matter, Your Honor,",
  "EXEDIR/BUNKA_SD.EXN:0x8035": "I am most deeply grateful.",
  "EXEDIR/BUNKA_SD.EXN:0x8055": "Now, now,",
  "EXEDIR/BUNKA_SD.EXN:0x8069": "that was no trouble at all.",
  "EXEDIR/BUNKA_SD.EXN:0x8089": "But you, Echigoya --",
  "EXEDIR/BUNKA_SD.EXN:0x80ad": "with that pest Iseya gone,",
  "EXEDIR/BUNKA_SD.EXN:0x80d5": "all the timber trade in Kamigata",
  "EXEDIR/BUNKA_SD.EXN:0x80f9": "now falls into your hands.",
  "EXEDIR/BUNKA_SD.EXN:0x8121": "You are quite the villain yourself.",
  "EXEDIR/BUNKA_SD.EXN:0x813d": "No, no, I owe it all",
  "EXEDIR/BUNKA_SD.EXN:0x8155": "to Your Honor's teaching,",
  "EXEDIR/BUNKA_SD.EXN:0x8171": "my lord.",
  "EXEDIR/BUNKA_SD.EXN:0x8181": "So, as a token of thanks,",
  "EXEDIR/BUNKA_SD.EXN:0x819d": "castella cake from abroad,",
  "EXEDIR/BUNKA_SD.EXN:0x81b5": "my lord.",
  "EXEDIR/BUNKA_SD.EXN:0x81c5": "Oho!",
  "EXEDIR/BUNKA_SD.EXN:0x81d9": "I simply cannot resist",
  "EXEDIR/BUNKA_SD.EXN:0x81f5": "golden sweets!",
  "EXEDIR/BUNKA_SD.EXN:0x8235": "Also,",
  "EXEDIR/BUNKA_SD.EXN:0x8241": "in the next room,",
  "EXEDIR/BUNKA_SD.EXN:0x8261": "a Japanese doll",
  "EXEDIR/BUNKA_SD.EXN:0x8275": "awaits you, my lord,",
  "EXEDIR/BUNKA_SD.EXN:0x828d": "so please, enjoy yourself.",
  "EXEDIR/BUNKA_SD.EXN:0x82a9": "Echigoya!",
  "EXEDIR/BUNKA_SD.EXN:0x82c1": "Now this is quite",
  "EXEDIR/BUNKA_SD.EXN:0x82d5": "a lovely Japanese doll.",
  "EXEDIR/BUNKA_SD.EXN:0x82ed": "We-ell,",
  "EXEDIR/BUNKA_SD.EXN:0x8305": "let's have a little fun.",
  "EXEDIR/BUNKA_SD.EXN:0x8321": "Sweet thing, sweet thing.",
  "EXEDIR/BUNKA_SD.EXN:0x8339": "A samurai drama classic:",
  "EXEDIR/BUNKA_SD.EXN:0x8359": "the Maiden Spin Dance!",
  "EXEDIR/BUNKA_SD.EXN:0x8371": "Wh-who goes there!",
  "EXEDIR/BUNKA_SD.EXN:0x8385": "Axe on his shoulder, Kintaro!",
  "EXEDIR/BUNKA_SD.EXN:0x83a1": "Kintaro?",
  "EXEDIR/BUNKA_SD.EXN:0x83c1": "What a clown.",
  "EXEDIR/BUNKA_SD.EXN:0x83dd": "Do you know who",
  "EXEDIR/BUNKA_SD.EXN:0x83f1": "this gentleman is?!",
  "EXEDIR/BUNKA_SD.EXN:0x8409": "Finance Magistrate Ohashi Daizen!",
  "EXEDIR/BUNKA_SD.EXN:0x8429": "My face --",
  "EXEDIR/BUNKA_SD.EXN:0x843d": "surely you know it!",
  "EXEDIR/BUNKA_SD.EXN:0x8475": "The Shogun! We bow!",
  "EXEDIR/BUNKA_SD.EXN:0x848d": "Huh? Y-yes, my lord!",
  "EXEDIR/BUNKA_SD.EXN:0x84a5": "Ohashi Daizen!",
  "EXEDIR/BUNKA_SD.EXN:0x84c5": "Despite being Finance Magistrate,",
  "EXEDIR/BUNKA_SD.EXN:0x84dd": "you conspired with Echigoya,",
  "EXEDIR/BUNKA_SD.EXN:0x8501": "did away with Iseya the timber man,",
  "EXEDIR/BUNKA_SD.EXN:0x8521": "and monopolized the Shogun's timber",
  "EXEDIR/BUNKA_SD.EXN:0x853d": "to line your pockets. Unforgivable!",
  "EXEDIR/BUNKA_SD.EXN:0x856d": "I, Yoshimune,",
  "EXEDIR/BUNKA_SD.EXN:0x8581": "as Kintaro the Samurai, judge you!",
  "EXEDIR/BUNKA_SD.EXN:0x859d": "Take your own life with honor!",
  "EXEDIR/BUNKA_SD.EXN:0x85e1": "Shogun or not,",
  "EXEDIR/BUNKA_SD.EXN:0x85f5": "die here and you're just Kintaro!",
  "EXEDIR/BUNKA_SD.EXN:0x8611": "Master! If you please!",
  "EXEDIR/BUNKA_SD.EXN:0x862d": "Very well.",
  "EXEDIR/BUNKA_SD.EXN:0x8645": "My Swallow Wind blade",
  "EXEDIR/BUNKA_SD.EXN:0x865d": "will be the end of you!",
  "EXEDIR/BUNKA_SD.EXN:0x8675": "Kintaro, or whatever you are,",
  "EXEDIR/BUNKA_SD.EXN:0x8691": "now, fight me fair!",
  "EXEDIR/BUNKA_SD.EXN:0x86a5": "One!",
  "EXEDIR/BUNKA_SD.EXN:0x86c5": "Unshaven, scruffy lout.",
  "EXEDIR/BUNKA_SD.EXN:0x86e1": "Echigoya, do something!",
  "EXEDIR/BUNKA_SD.EXN:0x86f9": "Wh-, b-,",
  "EXEDIR/BUNKA_SD.EXN:0x8709": "but my lord, that's cruel...",
  "EXEDIR/BUNKA_SD.EXN:0x8721": "Two!",
  "EXEDIR/BUNKA_SD.EXN:0x8741": "Unwashed, smelly oaf.",
  "EXEDIR/BUNKA_SD.EXN:0x8759": "Three!",
  "EXEDIR/BUNKA_SD.EXN:0x8779": "Slobs who can't even groom --",
  "EXEDIR/BUNKA_SD.EXN:0x87ad": "Kintaro shall cut you down.",
  "EXEDIR/BUNKA_SD.EXN:0x87c8": "Echigoya",
  "EXEDIR/BUNKA_SD.EXN:0x87d0": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x87d8": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x87e0": "Echigoya",
  "EXEDIR/BUNKA_SD.EXN:0x87e8": "Echigoya",
  "EXEDIR/BUNKA_SD.EXN:0x87f0": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x87f8": "Both",
  "EXEDIR/BUNKA_SD.EXN:0x8808": "Echigoya",
  "EXEDIR/BUNKA_SD.EXN:0x8810": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x8818": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x8820": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x8828": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x8830": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x883c": "Echigoya",
  "EXEDIR/BUNKA_SD.EXN:0x8844": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x8850": "Both",
  "EXEDIR/BUNKA_SD.EXN:0x8860": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x886c": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x8878": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x8884": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x888c": "Echigoya",
  "EXEDIR/BUNKA_SD.EXN:0x8894": "Master",
  "EXEDIR/BUNKA_SD.EXN:0x889c": "Master",
  "EXEDIR/BUNKA_SD.EXN:0x88a4": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x88b0": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x88b8": "Echigoya",
  "EXEDIR/BUNKA_SD.EXN:0x88c0": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x88cc": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x88d8": "Kintaro",
  "EXEDIR/BUNKA_SD.EXN:0x88e8": "Magist.",
  "EXEDIR/BUNKA_SD.EXN:0x88f0": "\"Curse you...",
  "EXEDIR/BUNKA_SD.EXN:0x8a41": "Oh,",
  "EXEDIR/BUNKA_SD.EXN:0x8a59": "the light in that window,",
  "EXEDIR/BUNKA_SD.EXN:0x8a71": "shining high above me,",
  "EXEDIR/BUNKA_SD.EXN:0x8a89": "lighting up the night --",
  "EXEDIR/BUNKA_SD.EXN:0x8aa1": "you are an angel indeed,",
  "EXEDIR/BUNKA_SD.EXN:0x8ab9": "the very image of",
  "EXEDIR/BUNKA_SD.EXN:0x8acd": "a messenger of heaven.",
  "EXEDIR/BUNKA_SD.EXN:0x8ae1": "Oh,",
  "EXEDIR/BUNKA_SD.EXN:0x8af9": "Romeo, Romeo,",
  "EXEDIR/BUNKA_SD.EXN:0x8b11": "wherefore art thou Romeo?",
  "EXEDIR/BUNKA_SD.EXN:0x8b3d": "Ugh, oof,",
  "EXEDIR/BUNKA_SD.EXN:0x8b4d": "you're heavy, Julietta.",
  "EXEDIR/BUNKA_SD.EXN:0x8b65": "Not knowing that Julietta",
  "EXEDIR/BUNKA_SD.EXN:0x8b81": "only sleeps from a potion,",
  "EXEDIR/BUNKA_SD.EXN:0x8b9d": "Romeo now drinks poison",
  "EXEDIR/BUNKA_SD.EXN:0x8bb9": "to follow Julietta",
  "EXEDIR/BUNKA_SD.EXN:0x8bd1": "on her final journey.",
  "EXEDIR/BUNKA_SD.EXN:0x8be9": "Oh, with this cup of wine,",
  "EXEDIR/BUNKA_SD.EXN:0x8c05": "now to my beloved",
  "EXEDIR/BUNKA_SD.EXN:0x8c21": "I go.",
  "EXEDIR/BUNKA_SD.EXN:0x8c65": "Wake up, Julietta.",
  "EXEDIR/BUNKA_SD.EXN:0x8c80": "Romeo",
  "EXEDIR/BUNKA_SD.EXN:0x8c88": "Romeo",
  "EXEDIR/BUNKA_SD.EXN:0x8c90": "Julietta",
  "EXEDIR/BUNKA_SD.EXN:0x8ca0": "Julietta",
  "EXEDIR/BUNKA_SD.EXN:0x8cb0": "Romeo",
  "EXEDIR/BUNKA_SD.EXN:0x8cb8": "Narrator",
  "EXEDIR/BUNKA_SD.EXN:0x8cc8": "Narrator",
  "EXEDIR/BUNKA_SD.EXN:0x8cd8": "Romeo",
  "EXEDIR/BUNKA_SD.EXN:0x8ce8": "Julietta",
  "EXEDIR/BUNKA_SD.EXN:0x8cf8": "Romeo",
  "EXEDIR/BUNKA_SD.EXN:0x8de1": "Goons, listen!",
  "EXEDIR/BUNKA_SD.EXN:0x8df1": "Our mission today:",
  "EXEDIR/BUNKA_SD.EXN:0x8e09": "raid a kindergarten bus",
  "EXEDIR/BUNKA_SD.EXN:0x8e21": "and make the kids goons of our",
  "EXEDIR/BUNKA_SD.EXN:0x8e39": "Genma Empire Nazorah!",
  "EXEDIR/BUNKA_SD.EXN:0x8e4d": "Nazooo!",
  "EXEDIR/BUNKA_SD.EXN:0x8e5d": "For our great leader,",
  "EXEDIR/BUNKA_SD.EXN:0x8e79": "Holy Phantom Emperor Nazohl!",
  "EXEDIR/BUNKA_SD.EXN:0x8e99": "Nazooo!",
  "EXEDIR/BUNKA_SD.EXN:0x8ea9": "Not so fast, Nazorah!",
  "EXEDIR/BUNKA_SD.EXN:0x8ec5": "Naz! Naz! Naz! Naz!",
  "EXEDIR/BUNKA_SD.EXN:0x8ee1": "Cult Red!",
  "EXEDIR/BUNKA_SD.EXN:0x8ef1": "Cult Black!",
  "EXEDIR/BUNKA_SD.EXN:0x8f05": "Cult Blue!",
  "EXEDIR/BUNKA_SD.EXN:0x8f15": "Cult Yellow!",
  "EXEDIR/BUNKA_SD.EXN:0x8f29": "Cult Pink!",
  "EXEDIR/BUNKA_SD.EXN:0x8f39": "Quiz Squad Cultman!",
  "EXEDIR/BUNKA_SD.EXN:0x8f51": "Children are humanity's treasure!",
  "EXEDIR/BUNKA_SD.EXN:0x8f69": "Kidnap kindergartners?",
  "EXEDIR/BUNKA_SD.EXN:0x8f81": "Even if the Diet dissolves,",
  "EXEDIR/BUNKA_SD.EXN:0x8f99": "Cultman won't allow it!",
  "EXEDIR/BUNKA_SD.EXN:0x8fb5": "Like a moth to the flame, Cultman.",
  "EXEDIR/BUNKA_SD.EXN:0x8fd9": "Today is your end.",
  "EXEDIR/BUNKA_SD.EXN:0x8ffd": "Goons, get them!",
  "EXEDIR/BUNKA_SD.EXN:0x9011": "Nazoo!",
  "EXEDIR/BUNKA_SD.EXN:0x901d": "Beginner Cult Quiz!",
  "EXEDIR/BUNKA_SD.EXN:0x9031": "Of 100 colored sheets,",
  "EXEDIR/BUNKA_SD.EXN:0x9045": "what color is the 99th?",
  "EXEDIR/BUNKA_SD.EXN:0x905d": "Naz? Naz? Naz?",
  "EXEDIR/BUNKA_SD.EXN:0x9079": "Nazoo!",
  "EXEDIR/BUNKA_SD.EXN:0x9085": "Curses!",
  "EXEDIR/BUNKA_SD.EXN:0x909d": "Pathetic goons.",
  "EXEDIR/BUNKA_SD.EXN:0x90b5": "That quiz will not work",
  "EXEDIR/BUNKA_SD.EXN:0x90d1": "on me, Zen Monster Mondo!",
  "EXEDIR/BUNKA_SD.EXN:0x90ed": "The answer is white!",
  "EXEDIR/BUNKA_SD.EXN:0x9105": "How's that, Cultman?",
  "EXEDIR/BUNKA_SD.EXN:0x911d": "Yup, that's right!",
  "EXEDIR/BUNKA_SD.EXN:0x9131": "Transcontinental Ultra Cannon!",
  "EXEDIR/BUNKA_SD.EXN:0x914d": "Target locked!",
  "EXEDIR/BUNKA_SD.EXN:0x915d": "Fire!",
  "EXEDIR/BUNKA_SD.EXN:0x9169": "Gyaaah!",
  "EXEDIR/BUNKA_SD.EXN:0x9179": "I can't believe this!",
  "EXEDIR/BUNKA_SD.EXN:0x9191": "Cultman!",
  "EXEDIR/BUNKA_SD.EXN:0x91ad": "Someday I, Omoguro Seminar,",
  "EXEDIR/BUNKA_SD.EXN:0x91c9": "will beat you all!",
  "EXEDIR/BUNKA_SD.EXN:0x91e5": "Just you wait!",
  "EXEDIR/BUNKA_SD.EXN:0x91f5": "Once again,",
  "EXEDIR/BUNKA_SD.EXN:0x9205": "thanks to Cultman,",
  "EXEDIR/BUNKA_SD.EXN:0x9221": "the Nazorahs' plot was foiled.",
  "EXEDIR/BUNKA_SD.EXN:0x9241": "But ever stronger monsters",
  "EXEDIR/BUNKA_SD.EXN:0x9259": "from the Genma Empire",
  "EXEDIR/BUNKA_SD.EXN:0x9271": "are sure to come.",
  "EXEDIR/BUNKA_SD.EXN:0x9285": "Go, go,",
  "EXEDIR/BUNKA_SD.EXN:0x9291": "our Cultman!",
  "EXEDIR/BUNKA_SD.EXN:0x92a8": "Mondo",
  "EXEDIR/BUNKA_SD.EXN:0x92bc": "Mondo",
  "EXEDIR/BUNKA_SD.EXN:0x92d0": "Goon",
